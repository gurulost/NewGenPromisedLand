# Chronicles of the Promised Land - Environment Configuration

# ============================================
# Error Tracking & Monitoring (Optional)
# ============================================

# Sentry Configuration
# Get your DSN from https://sentry.io
# VITE_SENTRY_DSN=https://your-dsn@sentry.io/your-project-id
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=your-auth-token

# PostHog Analytics Configuration
# Get your API key from https://posthog.com
# Preferred variable names:
# VITE_POSTHOG_KEY=phc_your-api-key-here
# VITE_POSTHOG_HOST=https://us.i.posthog.com
#
# Backward compatible aliases (also supported by the app):
# VITE_PUBLIC_POSTHOG_KEY=phc_your-api-key-here
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================
# Logging Configuration
# ============================================

# Bug report intake
# Set to "false" to hide the in-game bug report launcher.
# VITE_BUG_REPORTING_ENABLED=true
#
# Optional webhook for new player bug reports.
# BUG_REPORT_WEBHOOK_URL=https://hooks.example.com/services/...
#
# Optional base URL used to generate direct "Full Report" links in webhook alerts.
# BUG_REPORT_PUBLIC_URL=https://your-app.example.com
#
# Optional bearer token required to open direct bug report detail links.
# Set this to a long random string if you want webhook alerts to include a "Full Report" link.
# BUG_REPORT_VIEW_TOKEN=replace-with-a-long-random-secret
#
# Optional DB/admin deep-link template for webhook alerts.
# Supported placeholders: {id} {reportId} {submissionId} {fingerprint} {category} {source} {createdAt}
# BUG_REPORT_DB_URL_TEMPLATE=https://db.example.com/bug_reports?id={id}

# Object storage for voice notes and bug-report screenshots
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_BUCKET_NAME=your-bucket-name
# R2_PUBLIC_URL=https://cdn.example.com/assets
#
# Restrict Animation Lab in production.
# The route stays open in development, but production requires the correct answer.
# ANIMATION_LAB_ACCESS_ANSWER=replace-with-your-private-answer
# Optional override if you ever want to change the question text shown on the unlock screen.
# ANIMATION_LAB_ACCESS_QUESTION=Who was the queen of all cats, born in a garage?
# Optional unlock duration in hours. Defaults to 12.
# ANIMATION_LAB_ACCESS_TTL_HOURS=12

# Set log level (debug, info, warn, error)
# LOG_LEVEL=info

# Node Environment
NODE_ENV=development

# ============================================
# Application Configuration
# ============================================

# Application version (for Sentry releases)
# VITE_APP_VERSION=1.0.0

# ============================================
# Setup Instructions
# ============================================

# 1. Copy this file to .env:
#    cp .env.example .env

# 2. (Optional) Set up Sentry for error tracking:
#    - Create account at https://sentry.io
#    - Create a new project
#    - Copy the DSN and add to VITE_SENTRY_DSN
#    - For source map uploads, add org, project, and auth token

# 3. (Optional) Set up PostHog for game analytics:
#    - Create account at https://posthog.com
#    - Create a new project
#    - Copy the API key and add to VITE_POSTHOG_KEY
#    - (Optional) Set VITE_POSTHOG_HOST if using EU or self-hosted

# 4. (Optional) Configure logging:
#    - Set LOG_LEVEL to control server-side logging verbosity
#    - Use 'debug' for development, 'info' for production

# 5. (Optional) Configure bug reporting:
#    - Set VITE_BUG_REPORTING_ENABLED=false to hide the launcher
#    - Set BUG_REPORT_WEBHOOK_URL if you want new report notifications
#    - Set BUG_REPORT_PUBLIC_URL + BUG_REPORT_VIEW_TOKEN if you want direct "Full Report" links in alerts
#    - Set BUG_REPORT_DB_URL_TEMPLATE if your DB/admin tool supports deep links to bug report rows
#    - Configure the R2_* variables if you want screenshot uploads

# 6. (Optional) Lock Animation Lab in production:
#    - Set ANIMATION_LAB_ACCESS_ANSWER to the private answer you want the unlock screen to accept
#    - (Optional) Override ANIMATION_LAB_ACCESS_QUESTION or ANIMATION_LAB_ACCESS_TTL_HOURS

# 7. Restart the development server after making changes
